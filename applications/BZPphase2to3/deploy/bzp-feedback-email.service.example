[Unit]
Description=BZP Phase III Planning Explorer feedback email worker
After=network.target bzp-phase3-demo.service

[Service]
Type=oneshot
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__VENV_DIR__/bin/python scripts/process_feedback_email_outbox.py --limit 20
NoNewPrivileges=true
PrivateTmp=true
