# Copy to an access-controlled file on the target server, for example:
# /etc/bzp-phase3-demo/bzp-phase3-demo.env

SPONSOR_DEMO_VERSION=BZP Phase III Planning Explorer 2026.07.28
SPONSOR_DEMO_USERNAME=SET_A_SHARED_SPONSOR_USERNAME
SPONSOR_DEMO_PASSWORD=SET_A_STRONG_SHARED_SPONSOR_PASSWORD

# Writable server-side state: feedback database, uploads, and changelog content.
SPONSOR_DEMO_LOCAL_DATA_ROOT=/var/lib/bzp-phase3-demo

# Feedback email is optional. Keep disabled unless the values below are supplied
# through the server's protected secret-management process.
SPONSOR_EMAIL_ENABLED=0
# SPONSOR_GMAIL_ADDRESS=
# SPONSOR_FEEDBACK_NOTIFY_TO=
# SPONSOR_GMAIL_APP_PASSWORD_FILE=/etc/bzp-phase3-demo/gmail_app_password
# SPONSOR_SMTP_HOST=smtp.gmail.com
# SPONSOR_SMTP_PORT=465
# SPONSOR_EMAIL_FROM_NAME=BlueBalloon BlueLab
