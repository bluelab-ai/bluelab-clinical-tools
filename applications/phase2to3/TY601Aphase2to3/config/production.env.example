# Copy to a protected file outside the repository and set permissions to 0600.
PLANNING_TOOL_USERNAME=BlueBallon
PLANNING_TOOL_PASSWORD=replace-with-a-strong-password
PLANNING_TOOL_SESSION_MINUTES=480
PLANNING_TOOL_MAX_FAILURES=5
PLANNING_TOOL_LOCK_SECONDS=60

# Optional portal single-use ticket validation.
PORTAL_TICKET_SECRET=replace-with-a-random-shared-secret

# Optional feedback delivery. Keep the app password in a separate 0600 file.
SPONSOR_EMAIL_ENABLED=0
TAPGREL_FEEDBACK_NOTIFY_TO=feedback@example.com
SPONSOR_SMTP_HOST=smtp.example.com
SPONSOR_SMTP_PORT=465
SPONSOR_GMAIL_ADDRESS=sender@example.com
SPONSOR_GMAIL_APP_PASSWORD_FILE=/secure/path/ty601a-smtp-password
