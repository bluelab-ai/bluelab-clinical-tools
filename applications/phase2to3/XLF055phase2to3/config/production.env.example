# Copy to a protected file outside the repository and set permissions to 0600.
XLF055_APP_USERNAME=BlueBallon
XLF055_APP_PASSWORD=replace-with-a-strong-password
XLF055_APP_SESSION_MINUTES=480
XLF055_APP_MAX_FAILURES=5
XLF055_APP_LOCK_SECONDS=60

# Optional portal single-use ticket validation.
PORTAL_TICKET_SECRET=replace-with-a-random-shared-secret

# Optional feedback delivery. Keep the app password in a separate 0600 file.
XLF055_FEEDBACK_EMAIL_ENABLED=0
XLF055_FEEDBACK_NOTIFY_TO=feedback@example.com
XLF055_FEEDBACK_SMTP_HOST=smtp.example.com
XLF055_FEEDBACK_SMTP_PORT=465
XLF055_FEEDBACK_SMTP_USERNAME=sender@example.com
XLF055_FEEDBACK_SMTP_PASSWORD_FILE=/secure/path/xlf055-smtp-password
